local function getCenterScreenTarget()
	local screenCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
	local closestTarget = nil
	local closestDist = math.huge

	for _, otherPlayer in ipairs(Players:GetPlayers()) do
		if otherPlayer ~= player and otherPlayer.Character then
			local oRoot = otherPlayer.Character:FindFirstChild("HumanoidRootPart")
			local oHum = otherPlayer.Character:FindFirstChildOfClass("Humanoid")

			if oRoot and oHum and oHum.Health > 0 then
				local screenPos, onScreen = camera:WorldToViewportPoint(oRoot.Position)
				if onScreen and screenPos.Z > 0 then
					local dist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
					if dist < closestDist then
						closestDist = dist
						closestTarget = oRoot
					end
				end
			end
		end
	end
	return closestTarget
end

local function cleanStandAura()
	if standHighlight then
		standHighlight:Destroy()
		standHighlight = nil
	end
end

local function updateUIStates()
	if isZeroG then
		zeroGBtn.Text = "ZERO-G: ON"
		zeroGBtn.TextColor3 = COLOR_TEXT
		registerRgb(zStroke, "Color")
	else
		zeroGBtn.Text = "ZERO-G: OFF"
		zeroGBtn.TextColor3 = COLOR_MUTED
		unregisterRgb(zStroke)
		zStroke.Color = COLOR_LIGHT_DARK
	end

	if isLocked then
		lockBtn.Text = "FOLLOW: ON"
		lockBtn.TextColor3 = COLOR_TEXT
		registerRgb(lStroke, "Color")
	else
		lockBtn.Text = "FOLLOW: OFF"
		lockBtn.TextColor3 = COLOR_MUTED
		unregisterRgb(lStroke)
		lStroke.Color = COLOR_LIGHT_DARK
	end
end

local function setLockedState(active)
	if active then
		if not isZeroG then return end
		local target = getCenterScreenTarget()
		if target then
			lockTarget = target
			isLocked = true
			orbitAngle = 0
		else
			isLocked = false
			lockTarget = nil
		end
	else
		isLocked = false
		lockTarget = nil
		cleanStandAura()
	end
	updateUIStates()
end

local function setZeroGState(active)
	isZeroG = active
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")

	if isZeroG then
		if hum then hum.PlatformStand = true end
		currentSpeed = MIN_FLIGHT_SPEED
		currentVelocity = Vector3.zero
	else
		setLockedState(false)
		if hum and root then
			hum.PlatformStand = false
			local look = root.CFrame.LookVector
			root.CFrame = CFrame.lookAt(root.Position, root.Position + Vector3.new(look.X, 0, look.Z))
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
		end
	end
	updateUIStates()
end

zeroGBtn.Activated:Connect(function()
	setZeroGState(not isZeroG)
end)

lockBtn.Activated:Connect(function()
	if not isZeroG then return end
	setLockedState(not isLocked)
end)

