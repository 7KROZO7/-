local currentRgb = Color3.fromRGB(0, 245, 215)
local rgbItems = {}

local function registerRgb(inst, prop)
	table.insert(rgbItems, { Instance = inst, Property = prop })
end

local function unregisterRgb(inst)
	for i = #rgbItems, 1, -1 do
		if rgbItems[i].Instance == inst then
			table.remove(rgbItems, i)
		end
	end
end

RunService.RenderStepped:Connect(function()
	currentRgb = Color3.fromHSV((os.clock() * 0.35) % 1, 0.85, 1)
	for i = #rgbItems, 1, -1 do
		local item = rgbItems[i]
		if item.Instance and item.Instance.Parent then
			item.Instance[item.Property] = currentRgb
		else
			table.remove(rgbItems, i)
		end
	end
	if standHighlight and standHighlight.Parent then
		standHighlight.OutlineColor = currentRgb
	end
end)

