RunService.Stepped:Connect(function()
	local isStandMode = (isZeroG and isLocked and MODES[currentModeIndex].Id == "Stand")
	local char = player.Character
	if not char then return end

	-- Manage Stand Highlight Aura
	if isStandMode then
		if not standHighlight then
			standHighlight = Instance.new("Highlight")
			standHighlight.Name = "StandAura"
			standHighlight.FillColor = Color3.fromRGB(150, 60, 255)
			standHighlight.FillTransparency = 0.55
			standHighlight.OutlineColor = currentRgb
			standHighlight.OutlineTransparency = 0
			standHighlight.Parent = char
		end
	else
		cleanStandAura()
	end

	-- Apply your custom R6 joint transforms
	if isStandMode then
		local t = os.clock()
		local breathe = math.sin(t * 2) * 0.04

		local torso = char:FindFirstChild("Torso")
		local rootPart = char:FindFirstChild("HumanoidRootPart")

		for jointName, data in pairs(CustomStandPose.Joints) do
			local joint = (torso and torso:FindFirstChild(jointName)) or (rootPart and rootPart:FindFirstChild(jointName))

			if joint and joint:IsA("Motor6D") then
				local radX = math.rad(data.Rot.X)
				local radY = math.rad(data.Rot.Y)
				local radZ = math.rad(data.Rot.Z)

				-- Slight breathing float offset
				local posOffset = data.Pos + Vector3.new(0, breathe, 0)
				joint.Transform = CFrame.new(posOffset) * CFrame.fromEulerAnglesXYZ(radX, radY, radZ)
			end
		end
	end
end)

--------------------------------------------------------------------------------
-- 8. FLIGHT ENGINE & MOMENTUM KNOCKBACK
--------------------------------------------------------------------------------

-- Checks for high-speed collisions and applies momentum knockback
local function checkImpactKnockback(myRoot, speed)
	if speed < MIN_KNOCKBACK_SPEED or (os.clock() - lastImpactTime < 0.35) then return end

	for _, otherPlayer in ipairs(Players:GetPlayers()) do
		if otherPlayer ~= player and otherPlayer.Character then
			local oRoot = otherPlayer.Character:FindFirstChild("HumanoidRootPart")
			local oHum = otherPlayer.Character:FindFirstChildOfClass("Humanoid")

			if oRoot and oHum and oHum.Health > 0 then
				local dist = (oRoot.Position - myRoot.Position).Magnitude
				if dist <= 4.2 then
					lastImpactTime = os.clock()

					-- Calculate force ratio based on speed
					local speedRatio = math.clamp((speed - MIN_KNOCKBACK_SPEED) / (MAX_FLIGHT_SPEED - MIN_KNOCKBACK_SPEED), 0.15, 1.0)
					local knockbackForce = speedRatio * MAX_KNOCKBACK_FORCE

					-- Direct impulse away from impact + slight vertical lift
					local impactDir = (oRoot.Position - myRoot.Position).Unit
					local pushVelocity = (impactDir + Vector3.new(0, 0.3, 0)).Unit * knockbackForce

					oRoot.AssemblyLinearVelocity = pushVelocity

					-- Self-recoil (momentum bounce)
					myRoot.AssemblyLinearVelocity = -impactDir * (speed * 0.3)
					currentVelocity = -impactDir * (speed * 0.25)
					break
				end
			end
		end
	end
end

RunService.Heartbeat:Connect(function(dt)
	if not isZeroG then return end

	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not root or not hum or hum.Health <= 0 then return end

	if not hum.PlatformStand then
		hum.PlatformStand = true
	end

	-- FOLLOW MODES
	if isLocked and lockTarget and lockTarget.Parent then
		local targetHum = lockTarget.Parent:FindFirstChildOfClass("Humanoid")
		if not targetHum or targetHum.Health <= 0 then
			setLockedState(false)
			return
		end

		local t = os.clock()
		local activeMode = MODES[currentModeIndex].Id
		local targetPos = lockTarget.Position
		local targetCFrame = lockTarget.CFrame
		local targetVel = lockTarget.AssemblyLinearVelocity

		if activeMode == "Moon" then
			orbitAngle = orbitAngle + (0.8 * dt)
			local desired = targetPos + Vector3.new(math.cos(orbitAngle) * 18, math.sin(orbitAngle * 1.5) * 2.5, math.sin(orbitAngle) * 18)
			root.AssemblyLinearVelocity = (desired - root.Position) * 7
			root.AssemblyAngularVelocity = Vector3.new(math.sin(t * 1.5) * 3, math.cos(t * 2) * 3, math.sin(t * 2.5) * 3)

		elseif activeMode == "Balloon" then
			local bob = math.sin(t * 2.2) * 1.4
			local dragOffset = -targetVel * 0.28
			local desired = targetPos + Vector3.new(dragOffset.X, 11 + bob, dragOffset.Z)
			root.AssemblyLinearVelocity = (desired - root.Position) * 8
			root.AssemblyAngularVelocity = Vector3.new(dragOffset.Z * 0.5, math.sin(t) * 1.5, -dragOffset.X * 0.5)

		elseif activeMode == "Slingshot" then
			orbitAngle = orbitAngle + (1.6 * dt)
			local offset = Vector3.new(math.sin(orbitAngle) * 32, math.sin(orbitAngle * 2) * 3, math.cos(orbitAngle) * 10)
			local desired = targetCFrame:PointToWorldSpace(offset)
			root.AssemblyLinearVelocity = (desired - root.Position) * 10
			root.AssemblyAngularVelocity = Vector3.new(3, 5, 2)

		elseif activeMode == "Raincloud" then
			local bob = math.sin(t * 3) * 0.4
			local desired = targetPos + Vector3.new(0, 8.5 + bob, 0)
			root.AssemblyLinearVelocity = (desired - root.Position) * 14 + targetVel
			root.AssemblyAngularVelocity = Vector3.new(0, math.sin(t * 2) * 2, 0)

		elseif activeMode == "YoYo" then
			local dist = math.abs(math.sin(t * 1.6)) * 24 + 4
			local dir = Vector3.new(math.cos(t * 0.5), 0.25, math.sin(t * 0.5)).Unit
			local desired = targetPos + (dir * dist)
			root.AssemblyLinearVelocity = (desired - root.Position) * 9
			root.AssemblyAngularVelocity = Vector3.new(4, 2, 4)

		elseif activeMode == "Stand" then
			local floatBob = math.sin(t * 2.5) * 0.35
			local standCFrame = targetCFrame * CFrame.new(2.5, 2.2 + floatBob, 3.5)
			root.AssemblyLinearVelocity = (standCFrame.Position - root.Position) * 15 + targetVel
			root.CFrame = root.CFrame:Lerp(CFrame.lookAt(root.Position, root.Position + targetCFrame.LookVector), 0.25)
			root.AssemblyAngularVelocity = Vector3.zero
		end

	else
		-- PROGRESSIVE THRUSTER ACCELERATION & FLUID FLIGHT
		local moveDir = hum.MoveDirection

		if moveDir.Magnitude > 0 then
			-- Holding joystick builds speed over time
			currentSpeed = math.min(MAX_FLIGHT_SPEED, currentSpeed + (ACCELERATION_RATE * dt))

			-- Resolve 3D camera vector
			local camXZLook = (camera.CFrame.LookVector * Vector3.new(1, 0, 1)).Unit
			local camXZRight = (camera.CFrame.RightVector * Vector3.new(1, 0, 1)).Unit

			local forwardDot = moveDir:Dot(camXZLook)
			local rightDot = moveDir:Dot(camXZRight)

			local targetDir = (camera.CFrame.LookVector * forwardDot) + (camera.CFrame.RightVector * rightDot)
			if targetDir.Magnitude > 0 then
				targetDir = targetDir.Unit
			end

			-- Smooth steering trajectory
			currentVelocity = currentVelocity:Lerp(targetDir * currentSpeed, 8 * dt)
			root.AssemblyLinearVelocity = currentVelocity

			-- Banking tilt
			root.AssemblyAngularVelocity = Vector3.new(moveDir.Z * 2, 0, -moveDir.X * 2)

			-- Check for momentum-scaled impacts
			checkImpactKnockback(root, currentVelocity.Magnitude)
		else
			-- Coasting & Deceleration
			currentSpeed = math.max(MIN_FLIGHT_SPEED, currentSpeed - (DECELERATION_RATE * dt))
			currentVelocity = currentVelocity * math.clamp(1 - (2.5 * dt), 0, 1)

			if currentVelocity.Magnitude > 3 then
				root.AssemblyLinearVelocity = currentVelocity
			else
				-- Idle zero-gravity space drift
				local driftX = math.noise(os.clock() * 0.3, 0) * 3.5
				local driftY = math.sin(os.clock() * 0.8) * 2.5
				local driftZ = math.noise(0, os.clock() * 0.3) * 3.5
				root.AssemblyLinearVelocity = Vector3.new(driftX, driftY, driftZ)
			end

			root.AssemblyAngularVelocity = Vector3.new(
				math.sin(os.clock() * 0.5) * 1.8,
				math.cos(os.clock() * 0.4) * 1.8,
				math.sin(os.clock() * 0.3) * 1.8
			)
		end
	end
end)
