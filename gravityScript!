		lockBtn.TextColor3 = COLOR_TEXT
		registerRgb(lStroke, "Color")
	else
		lockBtn.Text = "FOLLOW: OFF"
		lockBtn.TextColor3 = COLOR_MUTED
		unregisterRgb(lStroke)
		lStroke.Color = COLOR_LIGHT_DARK
	end
end

local function setLockedState(active)
	if active then
		if not isZeroG then return end
		local target = getCenterScreenTarget()
		if target then
			lockTarget = target
			isLocked = true
			orbitAngle = 0
		else
			isLocked = false
			lockTarget = nil
		end
	else
		isLocked = false
		lockTarget = nil
		cleanStandAura()
	end
	updateUIStates()
end

local function setZeroGState(active)
	isZeroG = active
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")

	if isZeroG then
		if hum then hum.PlatformStand = true end
		currentSpeed = MIN_FLIGHT_SPEED
		currentVelocity = Vector3.zero
	else
		setLockedState(false)
		if hum and root then
			hum.PlatformStand = false
			local look = root.CFrame.LookVector
			root.CFrame = CFrame.lookAt(root.Position, root.Position + Vector3.new(look.X, 0, look.Z))
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
		end
	end
	updateUIStates()
end

