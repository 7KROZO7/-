local function toCFrame(pos, rot)
	return CFrame.new(pos) * CFrame.fromEulerAnglesXYZ(math.rad(rot.X), math.rad(rot.Y), math.rad(rot.Z))
end

-- Universal Motor6D Finder (Works across both R6 and R15 rigs)
local function findJointByName(char, jointName)
	for _, desc in ipairs(char:GetDescendants()) do
		if desc:IsA("Motor6D") and desc.Name == jointName then
			return desc
		end
	end
	return nil
end

local function parseUnifiedTable(text)
	local function extractJoints(block)
		local joints = {}
		if not block then return joints end
		for jointName, px, py, pz, rx, ry, rz in block:gmatch('%["([^"]+)"%]%s*=%s*%{%s*Pos%s*=%s*Vector3%.new%(([%d%.%-]+)%s*,%s*([%d%.%-]+)%s*,%s*([%d%.%-]+)%)%s*,%s*Rot%s*=%s*Vector3%.new%(([%d%.%-]+)%s*,%s*([%d%.%-]+)%s*,%s*([%d%.%-]+)%)') do
			joints[jointName] = toCFrame(Vector3.new(tonumber(px) or 0, tonumber(py) or 0, tonumber(pz) or 0), Vector3.new(tonumber(rx) or 0, tonumber(ry) or 0, tonumber(rz) or 0))
		end
		return joints
	end

	local rigType = text:match('RigType%s*=%s*"([^"]+)"') or "R6"
	local stance = text:match('Stance%s*=%s*"([^"]+)"') or "SHOULDER"
	local playerBlock = text:match('PlayerJoints%s*=%s*%{([^%}]+)%}') or text
	local standBlock = text:match('StandJoints%s*=%s*%{([^%}]+)%}')

	local pJoints = extractJoints(playerBlock)
	local sJoints = extractJoints(standBlock)

	return pJoints, sJoints, stance, rigType
end

