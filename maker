refreshPlaylistUI = function()
	for _, f in ipairs(slotFrames) do f:Destroy() end
	slotFrames = {}

	playlistHeader.Text = string.format("PLAYLIST (%d/6)", #playlist)

	if #playlist == 0 then
		local emptyNotice = Instance.new("TextLabel")
		emptyNotice.Size = UDim2.new(1, 0, 0, 40)
		emptyNotice.BackgroundTransparency = 1
		emptyNotice.Font = Enum.Font.GothamBold
		emptyNotice.Text = "NO POSES LOADED\nTAP '+ PASTE POSE' BELOW"
		emptyNotice.TextSize = 8
		emptyNotice.TextColor3 = COLOR_MUTED
		emptyNotice.Parent = slotScroll
		table.insert(slotFrames, emptyNotice)
	else
		for idx, pose in ipairs(playlist) do
			local card = Instance.new("Frame")
			card.Size = UDim2.new(1, -4, 0, 26)
			card.BackgroundColor3 = (isPlaying and idx == currentPoseIndex) and COLOR_ACTIVE or COLOR_BG
			card.BorderSizePixel = 0
			card.Parent = slotScroll
			local cc = Instance.new("UICorner")
			cc.CornerRadius = UDim.new(0, 4)
			cc.Parent = card

			local nameLabel = Instance.new("TextLabel")
			nameLabel.Size = UDim2.new(1, -72, 1, 0)
			nameLabel.Position = UDim2.new(0, 6, 0, 0)
			nameLabel.BackgroundTransparency = 1
			nameLabel.Font = Enum.Font.GothamBold
			nameLabel.Text = string.format("%d. %s", idx, pose.Name)
			nameLabel.TextSize = 8
			nameLabel.TextColor3 = (isPlaying and idx == currentPoseIndex) and COLOR_ACCENT or COLOR_TEXT
			nameLabel.TextXAlignment = Enum.TextXAlignment.Left
			nameLabel.Parent = card

			-- Move Up [ ▲ ]
			local upBtn = Instance.new("TextButton")
			upBtn.Size = UDim2.fromOffset(18, 18)
			upBtn.Position = UDim2.new(1, -66, 0.5, -9)
			upBtn.BackgroundColor3 = COLOR_LIGHT_DARK
			upBtn.BorderSizePixel = 0
			upBtn.Font = Enum.Font.GothamBold
			upBtn.Text = "▲"
			upBtn.TextSize = 7
			upBtn.TextColor3 = (idx > 1) and COLOR_TEXT or COLOR_MUTED
			upBtn.Parent = card
			local ubc = Instance.new("UICorner")
			ubc.CornerRadius = UDim.new(0, 3)
			ubc.Parent = upBtn

			upBtn.Activated:Connect(function()
				if idx > 1 then
					local item = table.remove(playlist, idx)
					table.insert(playlist, idx - 1, item)
					refreshPlaylistUI()
				end
			end)

			-- Move Down [ ▼ ]
			local downBtn = Instance.new("TextButton")
			downBtn.Size = UDim2.fromOffset(18, 18)
			downBtn.Position = UDim2.new(1, -44, 0.5, -9)
			downBtn.BackgroundColor3 = COLOR_LIGHT_DARK
			downBtn.BorderSizePixel = 0
			downBtn.Font = Enum.Font.GothamBold
			downBtn.Text = "▼"
			downBtn.TextSize = 7
			downBtn.TextColor3 = (idx < #playlist) and COLOR_TEXT or COLOR_MUTED
			downBtn.Parent = card
			local dbc = Instance.new("UICorner")
			dbc.CornerRadius = UDim.new(0, 3)
			dbc.Parent = downBtn

			downBtn.Activated:Connect(function()
				if idx < #playlist then
					local item = table.remove(playlist, idx)
					table.insert(playlist, idx + 1, item)
					refreshPlaylistUI()
				end
			end)

			-- Remove [ 🗑 ]
			local delBtn = Instance.new("TextButton")
			delBtn.Size = UDim2.fromOffset(18, 18)
			delBtn.Position = UDim2.new(1, -22, 0.5, -9)
			delBtn.BackgroundColor3 = Color3.fromRGB(50, 20, 25)
			delBtn.BorderSizePixel = 0
			delBtn.Font = Enum.Font.GothamBold
			delBtn.Text = "🗑"
			delBtn.TextSize = 8
			delBtn.TextColor3 = COLOR_DANGER
			delBtn.Parent = card
			local delc = Instance.new("UICorner")
			delc.CornerRadius = UDim.new(0, 3)
			delc.Parent = delBtn

			delBtn.Activated:Connect(function()
				table.remove(playlist, idx)
				if #playlist < currentPoseIndex then currentPoseIndex = 1 end
				if #playlist == 0 and isPlaying then stopPlayback() end
				refreshPlaylistUI()
				refreshModeButtons()
			end)

			table.insert(slotFrames, card)
		end
	end

	slotScroll.CanvasSize = UDim2.new(0, 0, 0, math.max(#playlist, 1) * 28 + 4)
end

