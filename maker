local function startPlayback()
	if #playlist == 0 then return end
	isPlaying = true
	currentPoseIndex = 1
	lastPoseIndex = 1
	transitionStartTime = os.clock()
	lastSwitchTime = os.clock()

	playBtn.Text = "⏹ STOP"
	playBtn.BackgroundColor3 = Color3.fromRGB(60, 20, 25)
	playBtn.TextColor3 = COLOR_DANGER
	minPlayBtn.Text = "⏹"
	minPlayBtn.TextColor3 = COLOR_DANGER

	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")

	if char then
		for jointName, _ in pairs(playlist[1].PlayerJoints) do
			local joint = findJointByName(char, jointName)
			startPlayerCF[jointName] = (joint and joint.Transform) or CFrame.identity
			activePlayerCF[jointName] = startPlayerCF[jointName]
		end
	end

	-- Freeze in place
	if root then root.Anchored = true end
	if hum then hum.WalkSpeed = 0; hum.JumpPower = 0 end

	spawnStandEntity()
	refreshPlaylistUI()
end

stopPlayback = function()
	isPlaying = false
	playBtn.Text = "▶ PLAY"
	playBtn.BackgroundColor3 = COLOR_LIGHT_DARK
	playBtn.TextColor3 = COLOR_ACCENT
	minPlayBtn.Text = "▶"
	minPlayBtn.TextColor3 = COLOR_ACCENT
	liveStatusBox.Text = "STATUS: STOPPED"
	minStatusText.Text = "MAKER: OFF"
	minStatusText.TextColor3 = COLOR_MUTED

	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")

	if root then root.Anchored = false end
	if hum then hum.WalkSpeed = 16; hum.JumpPower = 50 end

	local animator = hum and hum:FindFirstChildOfClass("Animator")
	if animator then
		for _, track in ipairs(animator:GetPlayingAnimationTracks()) do track:AdjustSpeed(1) end
	end

	-- Reset all joints to clean identity
	if char then
		for _, desc in ipairs(char:GetDescendants()) do
			if desc:IsA("Motor6D") then
				desc.Transform = CFrame.identity
			end
		end
	end

	removeStandEntity()
	refreshPlaylistUI()
end

playBtn.Activated:Connect(function()
	if isPlaying then stopPlayback() else startPlayback() end
end)

minPlayBtn.Activated:Connect(function()
	if isPlaying then stopPlayback() else startPlayback() end
end)

-- Physics Loop: Dual Rig Interpolation & Grounded Breathing
RunService.Stepped:Connect(function()
	local char = player.Character
	if not char or not isPlaying or #playlist == 0 then return end

	local root = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	local animator = hum and hum:FindFirstChildOfClass("Animator")

	if animator then
		for _, track in ipairs(animator:GetPlayingAnimationTracks()) do track:AdjustSpeed(0) end
	end

	local now = os.clock()

	-- "ゴゴゴ" Glyphs
	if now - lastGlyphTime >= 0.35 and root then
		lastGlyphTime = now
		spawnGlyph(root.Position)
	end

	-- Cycle/Shuffle Timer
	if playbackMode ~= "AuraFarm" and #playlist >= 2 then
		if now - lastSwitchTime >= switchInterval then
			lastSwitchTime = now
			transitionStartTime = now

			for jointName, cf in pairs(activePlayerCF) do startPlayerCF[jointName] = cf end
			for jointName, cf in pairs(activeStandCF) do startStandCF[jointName] = cf end

			if playbackMode == "Cycle" then
				currentPoseIndex = (currentPoseIndex % #playlist) + 1
			elseif playbackMode == "Shuffle" then
				local nextIdx = currentPoseIndex
				repeat nextIdx = math.random(1, #playlist) until nextIdx ~= lastPoseIndex
				currentPoseIndex = nextIdx
				lastPoseIndex = nextIdx
			end
			refreshPlaylistUI()
		end
	end

	local item = playlist[currentPoseIndex]
	if not item then return end

	liveStatusBox.Text = string.format("[%d/%d] %s", currentPoseIndex, #playlist, item.Name)
	minStatusText.Text = string.format("%d/%d: %s", currentPoseIndex, #playlist, item.Name)
	minStatusText.TextColor3 = COLOR_ACCENT

	local elapsed = now - transitionStartTime
	local rawAlpha = math.clamp(elapsed / TRANSITION_TIME, 0, 1)
	local smoothAlpha = rawAlpha * rawAlpha * (3 - 2 * rawAlpha)

	-- Grounded Breathing: ONLY modulates shoulders & neck
	local chestBreath = math.sin(now * 2.2) * 0.02
	local neckDrift = math.sin(now * 1.5) * 0.015

	-- 1. Apply to Human Avatar
	for jointName, targetCF in pairs(item.PlayerJoints) do
		local joint = findJointByName(char, jointName)
		if joint then
			local startCF = startPlayerCF[jointName] or targetCF
			local blendedCF = startCF:Lerp(targetCF, smoothAlpha)
			activePlayerCF[jointName] = blendedCF

			if jointName == "Neck" then
				joint.Transform = blendedCF * CFrame.Angles(neckDrift, 0, 0)
			elseif jointName:find("Shoulder") then
				joint.Transform = blendedCF * CFrame.new(0, chestBreath, 0)
			else
				joint.Transform = blendedCF
			end
		end
	end

	-- 2. Apply to Stand Entity
	if standEntity and root then
		local sRoot = standEntity:FindFirstChild("HumanoidRootPart")
		if sRoot then
			local offset = (item.Stance == "EMBRACE") and CFrame.new(0, 0.1, 0.65) or CFrame.new(2.5, 1.5, 2.5)
			sRoot.CFrame = root.CFrame * offset
		end

		-- Fallback: If StandJoints is empty, mirror player pose
		local standSource = (next(item.StandJoints) ~= nil) and item.StandJoints or item.PlayerJoints

		for jointName, targetCF in pairs(standSource) do
			local joint = findJointByName(standEntity, jointName)
			if joint then
				local startCF = startStandCF[jointName] or targetCF
				local blendedCF = startCF:Lerp(targetCF, smoothAlpha)
				activeStandCF[jointName] = blendedCF

				if jointName == "Neck" then
					joint.Transform = blendedCF * CFrame.Angles(neckDrift, 0, 0)
				elseif jointName:find("Shoulder") then
					joint.Transform = blendedCF * CFrame.new(0, chestBreath, 0)
				else
					joint.Transform = blendedCF
				end
			end
		end
	end
end)

