			delBtn.Parent = card
			local delc = Instance.new("UICorner")
			delc.CornerRadius = UDim.new(0, 3)
			delc.Parent = delBtn

			delBtn.Activated:Connect(function()
				table.remove(playlist, idx)
				if #playlist < currentPoseIndex then currentPoseIndex = 1 end
				if #playlist == 0 and isPlaying then stopPlayback() end
				refreshPlaylistUI()
				refreshModeButtons()
			end)

			table.insert(slotFrames, card)
		end
	end
	slotScroll.CanvasSize = UDim2.new(0, 0, 0, math.max(#playlist, 1) * 28 + 4)
end

