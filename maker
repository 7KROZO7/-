local function flashAura(char)
	if not poseHighlight then
		poseHighlight = Instance.new("Highlight")
		poseHighlight.Name = "PoseSequencerAura"
		poseHighlight.FillColor = currentRgb
		poseHighlight.FillTransparency = 0.35
		poseHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
		poseHighlight.OutlineTransparency = 0
		poseHighlight.Parent = char
	end

	poseHighlight.FillColor = currentRgb
	poseHighlight.FillTransparency = (playbackMode == "AuraFarm") and 0.45 or 0.25
	local tween = TweenService:Create(
		poseHighlight,
		TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ FillTransparency = 0.85 }
	)
	tween:Play()
end

local function startPlayback()
	if #playlist == 0 then return end
	isPlaying = true
	currentPoseIndex = 1
	lastPoseIndex = 1
	transitionStartTime = os.clock()
	lastSwitchTime = os.clock()

	playBtn.Text = "⏹ STOP"
	playBtn.BackgroundColor3 = Color3.fromRGB(60, 20, 25)
	playBtn.TextColor3 = COLOR_DANGER

	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local torso = char and char:FindFirstChild("Torso")

	-- Snapshot current joints as ease-in base
	if torso then
		for jointName, _ in pairs(playlist[1].Joints) do
			local joint = torso:FindFirstChild(jointName) or (root and root:FindFirstChild(jointName))
			startJointCFrames[jointName] = (joint and joint.Transform) or CFrame.identity
			activeJointCFrames[jointName] = startJointCFrames[jointName]
		end
	end

	-- Freeze In Place
	if root then root.Anchored = true end
	if hum then
		hum.WalkSpeed = 0
		hum.JumpPower = 0
	end

	flashAura(char)
	refreshPlaylistUI()
end

stopPlayback = function()
	isPlaying = false
	playBtn.Text = "▶ PLAY"
	playBtn.BackgroundColor3 = COLOR_LIGHT_DARK
	playBtn.TextColor3 = COLOR_ACCENT
	liveStatusBox.Text = "STATUS: STOPPED"
	liveStatusBox.TextColor3 = COLOR_MUTED

	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local torso = char and char:FindFirstChild("Torso")

	-- Unfreeze & restore movement
	if root then root.Anchored = false end
	if hum then
		hum.WalkSpeed = 16
		hum.JumpPower = 50
	end

	-- Unpause animations
	local animator = hum and hum:FindFirstChildOfClass("Animator")
	if animator then
		for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
			track:AdjustSpeed(1)
		end
	end

	-- Reset joint transforms back to neutral
	if torso then
		for _, name in ipairs({ "Neck", "RootJoint", "Right Shoulder", "Left Shoulder", "Right Hip", "Left Hip" }) do
			local joint = torso:FindFirstChild(name) or (root and root:FindFirstChild(name))
			if joint and joint:IsA("Motor6D") then
				joint.Transform = CFrame.identity
			end
		end
	end

	if poseHighlight then
		poseHighlight:Destroy()
		poseHighlight = nil
	end

	refreshPlaylistUI()
end

playBtn.Activated:Connect(function()
	if isPlaying then
		stopPlayback()
	else
		startPlayback()
	end
end)

-- Physics Pre-Step: Slerp Interpolation & Procedural Living Breath
RunService.Stepped:Connect(function()
	local char = player.Character
	if not char or not isPlaying or #playlist == 0 then return end

	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	local torso = char:FindFirstChild("Torso")
	local animator = hum and hum:FindFirstChildOfClass("Animator")

	-- Freeze active animations so they don't fight custom poses
	if animator then
		for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
			track:AdjustSpeed(0)
		end
	end

	local now = os.clock()

	-- Timer / Cycle Logic
	if playbackMode ~= "AuraFarm" and #playlist >= 2 then
		if now - lastSwitchTime >= switchInterval then
			lastSwitchTime = now
			transitionStartTime = now

			-- Snapshot current transforms as the start for the next ease
			for jointName, cf in pairs(activeJointCFrames) do
				startJointCFrames[jointName] = cf
			end

			if playbackMode == "Cycle" then
				currentPoseIndex = (currentPoseIndex % #playlist) + 1
			elseif playbackMode == "Shuffle" then
				-- Smart non-repeating shuffle
				local nextIdx = currentPoseIndex
				repeat
					nextIdx = math.random(1, #playlist)
				until nextIdx ~= lastPoseIndex
				currentPoseIndex = nextIdx
				lastPoseIndex = nextIdx
			end

			flashAura(char)
			refreshPlaylistUI()
		end
	end

	-- Update Status Box
	local activePose = playlist[currentPoseIndex]
	if activePose then
		if playbackMode == "AuraFarm" then
			liveStatusBox.Text = string.format("FARMING: %s", activePose.Name)
			liveStatusBox.TextColor3 = currentRgb
		else
			liveStatusBox.Text = string.format("PLAYING [%d/%d]: %s", currentPoseIndex, #playlist, activePose.Name)
			liveStatusBox.TextColor3 = COLOR_ACCENT
		end

		-- Slerp Transition Math
		local elapsed = now - transitionStartTime
		local rawAlpha = math.clamp(elapsed / TRANSITION_TIME, 0, 1)
		local smoothAlpha = rawAlpha * rawAlpha * (3 - 2 * rawAlpha)

		-- Procedural Living Idle Wave (Subtle Breathing & Head Drift)
		local breatheY = math.sin(now * 2.2) * 0.03
		local headTilt = math.sin(now * 1.6) * 0.015

		for jointName, targetCF in pairs(activePose.Joints) do
			local joint = (torso and torso:FindFirstChild(jointName)) or (root and root:FindFirstChild(jointName))
			if joint and joint:IsA("Motor6D") then
				local startCF = startJointCFrames[jointName] or targetCF
				local blendedCF = startCF:Lerp(targetCF, smoothAlpha)
				activeJointCFrames[jointName] = blendedCF

				-- Layer procedural breathing on top
				if jointName == "Neck" then
					joint.Transform = blendedCF * CFrame.Angles(headTilt, 0, 0)
				elseif jointName == "RootJoint" then
					joint.Transform = blendedCF * CFrame.new(0, breatheY, 0)
				else
					joint.Transform = blendedCF
				end
			end
		end
	end
end)

