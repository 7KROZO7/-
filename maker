local function toCFrame(pos, rot)
	return CFrame.new(pos) * CFrame.fromEulerAnglesXYZ(math.rad(rot.X), math.rad(rot.Y), math.rad(rot.Z))
end

local function parsePastedTable(text)
	local parsedJoints = {}
	for jointName, px, py, pz, rx, ry, rz in text:gmatch('%["([^"]+)"%]%s*=%s*%{%s*Pos%s*=%s*Vector3%.new%(([%d%.%-]+)%s*,%s*([%d%.%-]+)%s*,%s*([%d%.%-]+)%)%s*,%s*Rot%s*=%s*Vector3%.new%(([%d%.%-]+)%s*,%s*([%d%.%-]+)%s*,%s*([%d%.%-]+)%)') do
		local pos = Vector3.new(tonumber(px) or 0, tonumber(py) or 0, tonumber(pz) or 0)
		local rot = Vector3.new(tonumber(rx) or 0, tonumber(ry) or 0, tonumber(rz) or 0)
		parsedJoints[jointName] = toCFrame(pos, rot)
	end
	return parsedJoints
end

