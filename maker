refreshModeButtons = function()
	local count = #playlist

	if count == 0 then
		playBtn.TextColor3 = COLOR_MUTED
		playBtn.BackgroundColor3 = COLOR_BG
		playbackMode = "Cycle"

		auraFarmBtn.BackgroundColor3 = COLOR_BG
		auraFarmBtn.TextColor3 = COLOR_MUTED
		cycleBtn.BackgroundColor3 = COLOR_BG
		cycleBtn.TextColor3 = COLOR_MUTED
		shuffleBtn.BackgroundColor3 = COLOR_BG
		shuffleBtn.TextColor3 = COLOR_MUTED
	elseif count == 1 then
		playBtn.TextColor3 = COLOR_ACCENT
		playBtn.BackgroundColor3 = COLOR_LIGHT_DARK
		playbackMode = "AuraFarm"

		auraFarmBtn.BackgroundColor3 = COLOR_ACTIVE
		auraFarmBtn.TextColor3 = COLOR_ACCENT

		cycleBtn.BackgroundColor3 = COLOR_BG
		cycleBtn.TextColor3 = Color3.fromRGB(60, 65, 75) -- Dimmed disabled
		shuffleBtn.BackgroundColor3 = COLOR_BG
		shuffleBtn.TextColor3 = Color3.fromRGB(60, 65, 75) -- Dimmed disabled
	else
		playBtn.TextColor3 = COLOR_ACCENT
		playBtn.BackgroundColor3 = COLOR_LIGHT_DARK

		if playbackMode == "AuraFarm" then playbackMode = "Cycle" end

		auraFarmBtn.BackgroundColor3 = COLOR_BG
		auraFarmBtn.TextColor3 = COLOR_MUTED

		cycleBtn.BackgroundColor3 = (playbackMode == "Cycle") and COLOR_ACTIVE or COLOR_BG
		cycleBtn.TextColor3 = (playbackMode == "Cycle") and COLOR_ACCENT or COLOR_MUTED

		shuffleBtn.BackgroundColor3 = (playbackMode == "Shuffle") and COLOR_ACTIVE or COLOR_BG
		shuffleBtn.TextColor3 = (playbackMode == "Shuffle") and COLOR_ACCENT or COLOR_MUTED
	end
end

auraFarmBtn.Activated:Connect(function()
	if #playlist == 1 then
		playbackMode = "AuraFarm"
		refreshModeButtons()
	end
end)

cycleBtn.Activated:Connect(function()
