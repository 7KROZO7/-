	if #playlist == 0 then
		local emptyNotice = Instance.new("TextLabel")
		emptyNotice.Size = UDim2.new(1, 0, 0, 40)
		emptyNotice.BackgroundTransparency = 1
		emptyNotice.Font = Enum.Font.GothamBold
		emptyNotice.Text = "PLAYLIST EMPTY\nTAP '+ PASTE POSE' BELOW"
		emptyNotice.TextSize = 8
		emptyNotice.TextColor3 = COLOR_MUTED
		emptyNotice.Parent = slotScroll
		table.insert(slotFrames, emptyNotice)
	else
		for idx, item in ipairs(playlist) do
			local card = Instance.new("Frame")
			card.Size = UDim2.new(1, -4, 0, 26)
			card.BackgroundColor3 = (isPlaying and idx == currentPoseIndex) and COLOR_ACTIVE or COLOR_BG
			card.BorderSizePixel = 0
