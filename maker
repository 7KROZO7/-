local function spawnGlyph(position)
	local part = Instance.new("Part")
	part.Size = Vector3.new(0.05, 0.05, 0.05)
	part.CFrame = CFrame.new(position + Vector3.new(math.random(-25, 25) / 10, math.random(-5, 10) / 10, math.random(-25, 25) / 10))
	part.Transparency = 1
	part.CanCollide = false
	part.Anchored = true
	part.Parent = workspace

	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(32, 32)
	bb.AlwaysOnTop = true
	bb.Parent = part

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.fromScale(1, 1)
	lbl.BackgroundTransparency = 1
	lbl.Font = Enum.Font.GothamBold
	lbl.Text = "ゴ"
	lbl.TextSize = 24
	lbl.TextColor3 = Color3.fromRGB(160, 40, 240)
	lbl.Parent = bb

	local tween = TweenService:Create(
		part,
		TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ CFrame = part.CFrame * CFrame.new(0, 3.5, 0) }
	)
	local fadeTween = TweenService:Create(
		lbl,
		TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ TextTransparency = 1, TextSize = 14 }
	)

	tween:Play()
	fadeTween:Play()
	tween.Completed:Connect(function() part:Destroy() end)
end

local function spawnStandEntity()
	if standEntity then standEntity:Destroy() standEntity = nil end
	local char = player.Character
	if not char then return end

	char.Archivable = true
	local stand = char:Clone()
	char.Archivable = false
	stand.Name = "GhostStandEntity"

	for _, p in ipairs(stand:GetDescendants()) do
		if p:IsA("BasePart") then
			p.CanCollide = false
			p.Anchored = true
			p.Material = Enum.Material.ForceField
			p.Color = COLOR_STAND
			p.Transparency = 0.35
		elseif p:IsA("Script") or p:IsA("LocalScript") or p:IsA("Sound") then
			p:Destroy()
		end
	end

	stand.Parent = workspace
	standEntity = stand
end

local function removeStandEntity()
	if standEntity then standEntity:Destroy() standEntity = nil end
end

