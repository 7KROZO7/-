refreshModeButtons = function()
	local count = #playlist
	if count == 0 then
		playBtn.TextColor3 = COLOR_MUTED
		playBtn.BackgroundColor3 = COLOR_BG
		playbackMode = "Cycle"
		auraFarmBtn.BackgroundColor3 = COLOR_BG; auraFarmBtn.TextColor3 = COLOR_MUTED
		cycleBtn.BackgroundColor3 = COLOR_BG; cycleBtn.TextColor3 = COLOR_MUTED
		shuffleBtn.BackgroundColor3 = COLOR_BG; shuffleBtn.TextColor3 = COLOR_MUTED
	elseif count == 1 then
		playBtn.TextColor3 = COLOR_ACCENT
		playBtn.BackgroundColor3 = COLOR_LIGHT_DARK
		playbackMode = "AuraFarm"
		auraFarmBtn.BackgroundColor3 = COLOR_ACTIVE; auraFarmBtn.TextColor3 = COLOR_ACCENT
		cycleBtn.BackgroundColor3 = COLOR_BG; cycleBtn.TextColor3 = Color3.fromRGB(60, 65, 75)
		shuffleBtn.BackgroundColor3 = COLOR_BG; shuffleBtn.TextColor3 = Color3.fromRGB(60, 65, 75)
	else
		playBtn.TextColor3 = COLOR_ACCENT
		playBtn.BackgroundColor3 = COLOR_LIGHT_DARK
