-- Touch / Drag Logic
local dragging = false
local dragStart = Vector2.zero
local startPos = UDim2.new()
local movedDist = 0

toggleBtn.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		startPos = toggleBtn.Position
		movedDist = 0

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
				-- Clean tap (< 8 px movement) toggles posing
				if movedDist < 8 then
					isPosingActive = not isPosingActive
					local char = player.Character
					local root = char and char:FindFirstChild("HumanoidRootPart")
					local hum = char and char:FindFirstChildOfClass("Humanoid")
					local torso = char and char:FindFirstChild("Torso")

					if isPosingActive then
						-- Turn ON
						currentPoseIndex = 1
						transitionStartTime = os.clock()
						lastSwitchTime = os.clock()
						registerRgb(btnStroke, "Color")

						-- Store starting CFrame of each joint
						for jointName, _ in pairs(POSES_CFRAMES[1].Joints) do
							local joint = (torso and torso:FindFirstChild(jointName)) or (root and root:FindFirstChild(jointName))
							startJointCFrames[jointName] = (joint and joint.Transform) or CFrame.identity
							activeJointCFrames[jointName] = startJointCFrames[jointName]
						end

						-- Freeze In Place
						if root then root.Anchored = true end
						if hum then
							hum.WalkSpeed = 0
							hum.JumpPower = 0
						end
					else
						-- Turn OFF
						unregisterRgb(btnStroke)
						btnStroke.Color = COLOR_DARK
						statusLabel.Text = "JOJO: OFF"
						statusLabel.TextColor3 = COLOR_MUTED

						-- Unfreeze & restore movement
						if root then root.Anchored = false end
						if hum then
							hum.WalkSpeed = 16
							hum.JumpPower = 50
						end

						-- Restore normal default joints
						if torso then
							for jointName, _ in pairs(POSES_CFRAMES[1].Joints) do
								local joint = torso:FindFirstChild(jointName) or (root and root:FindFirstChild(jointName))
								if joint then
									joint.Transform = CFrame.identity
								end
							end
						end
					end
				end
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
		local delta = input.Position - dragStart
		movedDist = (Vector2.new(input.Position.X, input.Position.Y) - Vector2.new(dragStart.X, dragStart.Y)).Magnitude

		toggleBtn.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end)

--------------------------------------------------------------------------------
-- 5. FLASH AURA & JOINT ENGINE
--------------------------------------------------------------------------------

local poseHighlight = nil

local function flashPoseAura(char)
	if not poseHighlight then
		poseHighlight = Instance.new("Highlight")
		poseHighlight.Name = "JoJoAuraFlash"
		poseHighlight.FillColor = currentRgb
		poseHighlight.FillTransparency = 0.35
		poseHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
		poseHighlight.OutlineTransparency = 0
		poseHighlight.Parent = char
	end

	poseHighlight.FillColor = currentRgb
	poseHighlight.FillTransparency = 0.3
	local tween = TweenService:Create(
		poseHighlight,
		TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ FillTransparency = 0.85 }
	)
	tween:Play()
end

-- Physics Loop: Evaluates transitions and applies non-twisting Slerp
RunService.Stepped:Connect(function()
	local char = player.Character
	if not char or not isPosingActive then
		if poseHighlight then
			poseHighlight:Destroy()
			poseHighlight = nil
		end
		return
	end

	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	local torso = char:FindFirstChild("Torso")
	local animator = hum and hum:FindFirstChildOfClass("Animator")

	-- Freeze active animations so they don't fight your pose
	if animator then
		for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
			track:AdjustSpeed(0)
		end
	end

	local now = os.clock()

	-- Cycle poses every 1.5s
	if now - lastSwitchTime >= POSE_CYCLE_INTERVAL then
		lastSwitchTime = now
		transitionStartTime = now

		-- Snapshot current transforms as the start for the next ease
		for jointName, cf in pairs(activeJointCFrames) do
			startJointCFrames[jointName] = cf
		end

		currentPoseIndex = (currentPoseIndex % #POSES_CFRAMES) + 1
		flashPoseAura(char)
	end

	-- Update UI Status
	local activePose = POSES_CFRAMES[currentPoseIndex]
	statusLabel.Text = string.format("%d/6: %s", currentPoseIndex, activePose.Name)
	statusLabel.TextColor3 = COLOR_TEXT

	-- Fixed Transition Math: TRANSITION_TIME correctly referenced
	local elapsed = now - transitionStartTime
	local rawAlpha = math.clamp(elapsed / TRANSITION_TIME, 0, 1)
	local smoothAlpha = rawAlpha * rawAlpha * (3 - 2 * rawAlpha) -- Smoothstep

	for jointName, targetCF in pairs(activePose.Joints) do
		local joint = (torso and torso:FindFirstChild(jointName)) or (root and root:FindFirstChild(jointName))
		if joint and joint:IsA("Motor6D") then
			local startCF = startJointCFrames[jointName] or targetCF

			-- Slerp (Shortest rotational arc - prevents unhuman twisting)
			local blendedCF = startCF:Lerp(targetCF, smoothAlpha)
			activeJointCFrames[jointName] = blendedCF

			joint.Transform = blendedCF
		end
	end
end)
