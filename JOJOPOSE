local function toCFrame(entry)
	local p = entry.Pos
	local r = entry.Rot
	return CFrame.new(p) * CFrame.fromEulerAnglesXYZ(math.rad(r.X), math.rad(r.Y), math.rad(r.Z))
end

local POSES_CFRAMES = {}
for i, data in ipairs(RAW_POSES) do
	POSES_CFRAMES[i] = {
		Name = data.Name,
		Joints = {}
	}
	for jointName, rawJoint in pairs(data.Joints) do
		POSES_CFRAMES[i].Joints[jointName] = toCFrame(rawJoint)
	end
end

--------------------------------------------------------------------------------
-- 3. STATE & RGB ENGINE
--------------------------------------------------------------------------------

local isPosingActive = false
local currentPoseIndex = 1
local transitionStartTime = 0
local lastSwitchTime = 0

local startJointCFrames = {}
local activeJointCFrames = {}

local currentRgb = Color3.fromRGB(0, 245, 215)
local rgbItems = {}

local function registerRgb(inst, prop)
	table.insert(rgbItems, { Instance = inst, Property = prop })
end

local function unregisterRgb(inst)
	for i = #rgbItems, 1, -1 do
		if rgbItems[i].Instance == inst then
			table.remove(rgbItems, i)
		end
	end
end

RunService.RenderStepped:Connect(function()
	currentRgb = Color3.fromHSV((os.clock() * 0.4) % 1, 0.85, 1)
	for i = #rgbItems, 1, -1 do
		local item = rgbItems[i]
		if item.Instance and item.Instance.Parent then
			item.Instance[item.Property] = currentRgb
		else
			table.remove(rgbItems, i)
		end
	end
end)

