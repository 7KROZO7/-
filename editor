local function getSelectedPart()
	local char = player.Character
	if not char then return nil end
	local def = activeJointList[selectedLimbIndex]
	if not def then return nil end
	return char:FindFirstChild(def.PartName)
end

local function updateGizmoTarget()
	local targetPart = getSelectedPart()
	if targetPart then
		arcHandles.Adornee = targetPart
		moveHandles.Adornee = targetPart
		limbHighlight.Adornee = targetPart
		limbHighlight.Parent = targetPart
		limbHighlight.Enabled = true
	else
		arcHandles.Adornee = nil
		moveHandles.Adornee = nil
		limbHighlight.Enabled = false
	end
end

-- Gizmo Drag Logic (Rotation)
local initialRot = Vector3.zero
arcHandles.MouseButton1Down:Connect(function()
	local def = activeJointList[selectedLimbIndex]
	if def and poseData[def.JointName] then
		initialRot = poseData[def.JointName].Rot
	end
end)

arcHandles.MouseDrag:Connect(function(axis, relativeAngle)
	local def = activeJointList[selectedLimbIndex]
	if not def then return end
	local data = poseData[def.JointName]
	if not data then return end

	local deg = math.deg(relativeAngle)
	if axis == Enum.Axis.X then
		data.Rot = Vector3.new(initialRot.X + deg, data.Rot.Y, data.Rot.Z)
	elseif axis == Enum.Axis.Y then
		data.Rot = Vector3.new(data.Rot.X, initialRot.Y + deg, data.Rot.Z)
	elseif axis == Enum.Axis.Z then
		data.Rot = Vector3.new(data.Rot.X, data.Rot.Y, initialRot.Z + deg)
	end
end)

arcHandles.MouseButton1Up:Connect(pushHistory)

-- Gizmo Drag Logic (Translation)
local initialPos = Vector3.zero
moveHandles.MouseButton1Down:Connect(function()
	local def = activeJointList[selectedLimbIndex]
	if def and poseData[def.JointName] then
		initialPos = poseData[def.JointName].Pos
	end
end)

moveHandles.MouseDrag:Connect(function(axis, relativeDistance)
	local def = activeJointList[selectedLimbIndex]
	if not def then return end
	local data = poseData[def.JointName]
	if not data then return end

	if axis == Enum.Axis.X then
		data.Pos = Vector3.new(initialPos.X + relativeDistance, data.Pos.Y, data.Pos.Z)
	elseif axis == Enum.Axis.Y then
		data.Pos = Vector3.new(data.Pos.X, initialPos.Y + relativeDistance, data.Pos.Z)
	elseif axis == Enum.Axis.Z then
		data.Pos = Vector3.new(data.Pos.X, data.Pos.Y, initialPos.Z + relativeDistance)
	end
end)

moveHandles.MouseButton1Up:Connect(pushHistory)

