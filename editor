local function applyStep(amount)
	local data = getActiveData()
	if not data then return end
	pushHistory()
	if deckMode == "Rot" then
		local cur = data.Rot
		if activeAxis == "X" then data.Rot = Vector3.new(cur.X + amount, cur.Y, cur.Z)
		elseif activeAxis == "Y" then data.Rot = Vector3.new(cur.X, cur.Y + amount, cur.Z)
		elseif activeAxis == "Z" then data.Rot = Vector3.new(cur.X, cur.Y, cur.Z + amount) end
	else
		local cur = data.Pos
		if activeAxis == "X" then data.Pos = Vector3.new(cur.X + amount, cur.Y, cur.Z)
		elseif activeAxis == "Y" then data.Pos = Vector3.new(cur.X, cur.Y + amount, cur.Z)
		elseif activeAxis == "Z" then data.Pos = Vector3.new(cur.X, cur.Y, cur.Z + amount) end
	end
	refreshScrubberUI()
end

