undoBtn.Activated:Connect(function()
	if #undoStack > 0 then
		local last = table.remove(undoStack)
		local activeBank = (last.Target == "Human") and humanPoseData or standPoseData
		table.insert(redoStack, { Target = last.Target, Data = cloneBank(activeBank) })
		if last.Target == "Human" then humanPoseData = last.Data else standPoseData = last.Data end
		refreshScrubberUI()
	end
end)

redoBtn.Activated:Connect(function()
	if #redoStack > 0 then
		local nextState = table.remove(redoStack)
		local activeBank = (nextState.Target == "Human") and humanPoseData or standPoseData
		table.insert(undoStack, { Target = nextState.Target, Data = cloneBank(activeBank) })
		if nextState.Target == "Human" then humanPoseData = nextState.Data else standPoseData = nextState.Data end
		refreshScrubberUI()
	end
end)

