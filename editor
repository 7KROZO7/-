-- History Stacks
local undoStack = {}
local redoStack = {}

local function clonePoseData(src)
	local copy = {}
	for k, v in pairs(src) do
		copy[k] = { Pos = v.Pos, Rot = v.Rot }
	end
	return copy
end

local function pushHistory()
	table.insert(undoStack, clonePoseData(poseData))
	if #undoStack > 25 then
		table.remove(undoStack, 1)
	end
	redoStack = {} -- Reset redo stack on new action
end

local function initPoseData()
	poseData = {}
	for _, def in ipairs(activeJointList) do
		poseData[def.JointName] = { Pos = Vector3.zero, Rot = Vector3.zero }
	end
	undoStack = {}
	redoStack = {}
end
initPoseData()

