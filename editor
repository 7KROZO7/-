	if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
		isScrubbing = true
		lastTouchX = input.Position.X
		pushHistory()
		scrubLabel.TextColor3 = COLOR_TEXT
		scrubStroke.Color = Color3.fromRGB(255, 255, 255)

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				isScrubbing = false
				scrubLabel.TextColor3 = COLOR_MUTED
				scrubStroke.Color = axisColors[activeAxis]
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if isScrubbing and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
		local deltaX = input.Position.X - lastTouchX
		lastTouchX = input.Position.X
		local data = getActiveData()
		if not data then return end

		if deckMode == "Rot" then
			local deltaDeg = deltaX * 0.8
			local cur = data.Rot
			if activeAxis == "X" then data.Rot = Vector3.new(cur.X + deltaDeg, cur.Y, cur.Z)
			elseif activeAxis == "Y" then data.Rot = Vector3.new(cur.X, cur.Y + deltaDeg, cur.Z)
			elseif activeAxis == "Z" then data.Rot = Vector3.new(cur.X, cur.Y, cur.Z + deltaDeg) end
		else
			local deltaStuds = deltaX * 0.015
			local cur = data.Pos
			if activeAxis == "X" then data.Pos = Vector3.new(cur.X + deltaStuds, cur.Y, cur.Z)
			elseif activeAxis == "Y" then data.Pos = Vector3.new(cur.X, cur.Y + deltaStuds, cur.Z)
			elseif activeAxis == "Z" then data.Pos = Vector3.new(cur.X, cur.Y, cur.Z + deltaStuds) end
		end
		refreshScrubberUI()
	end
end)

