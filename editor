refreshScrubberUI = function()
	local data = getActiveData()
	if not data then return end

	if deckMode == "Rot" then
		local val = data.Rot[activeAxis]
		valueDisplay.Text = string.format("%s ROTATION: %d°", activeAxis, math.floor(val))
	else
		local val = data.Pos[activeAxis]
		valueDisplay.Text = string.format("%s POSITION: %.2f", activeAxis, val)
	end
	valueDisplay.TextColor3 = axisColors[activeAxis]
	scrubStroke.Color = axisColors[activeAxis]
