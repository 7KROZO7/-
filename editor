local function detectRig()
	local char = player.Character or player.CharacterAdded:Wait()
	local hum = char:WaitForChild("Humanoid", 5)
	if hum and hum.RigType == Enum.HumanoidRigType.R15 then
		currentRigType = "R15"
		activeJointList = R15_JOINTS
	else
		currentRigType = "R6"
		activeJointList = R6_JOINTS
	end
	rigToggleBtn.Text = "RIG: " .. currentRigType
	initPoseData()
	buildLimbButtons()
	refreshScrubberUI()
end

task.spawn(detectRig)
player.CharacterAdded:Connect(detectRig)

-- Continuous Render Loop: Positions the 3D FRONT & BACK markers relative to character facing
RunService.RenderStepped:Connect(function()
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root then
		-- Mathematical alignment: -Z is ALWAYS Front (toes), +Z is ALWAYS Back (heels)
		frontMarker.CFrame = root.CFrame * CFrame.new(0, -2.8, -3.8)
		backMarker.CFrame  = root.CFrame * CFrame.new(0, -2.8,  3.8)
	end
end)

-- Physics Pre-Step: Freezes background animations and applies custom transforms
RunService.Stepped:Connect(function()
	local char = player.Character
	if not char then return end

	local hum = char:FindFirstChildOfClass("Humanoid")
	local animator = hum and hum:FindFirstChildOfClass("Animator")

	if animator then
		for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
			track:AdjustSpeed(0)
		end
	end

	for _, def in ipairs(activeJointList) do
		local data = poseData[def.JointName]
		if data then
			local parentPart = char:FindFirstChild(def.ParentPart)
			local joint = parentPart and parentPart:FindFirstChild(def.JointName)

			if joint and joint:IsA("Motor6D") then
				local radX = math.rad(data.Rot.X)
				local radY = math.rad(data.Rot.Y)
				local radZ = math.rad(data.Rot.Z)

				joint.Transform = CFrame.new(data.Pos) * CFrame.fromEulerAnglesXYZ(radX, radY, radZ)
			end
		end
	end
end)
