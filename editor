local function fullRestore()
	mainWindow.Visible = false
	minPill.Visible = true
	isEditorActive = false
	setMarkersVisible(false)
	limbHighlight.Enabled = false
	removeReferenceDummy()

	local char = player.Character
	if not char then return end

	local hum = char:FindFirstChildOfClass("Humanoid")
	local animator = hum and hum:FindFirstChildOfClass("Animator")
	if animator then
		for _, track in ipairs(animator:GetPlayingAnimationTracks()) do track:AdjustSpeed(1) end
	end

	for _, def in ipairs(activeJointList) do
		local parentPart = char:FindFirstChild(def.ParentPart)
		local joint = parentPart and parentPart:FindFirstChild(def.JointName)
		if joint and joint:IsA("Motor6D") then joint.Transform = CFrame.identity end
	end
end

