RunService.Stepped:Connect(function()
	if not isEditorActive then return end
	local char = player.Character
	if not char then return end

	local hum = char:FindFirstChildOfClass("Humanoid")
	local animator = hum and hum:FindFirstChildOfClass("Animator")
	if animator then
		for _, track in ipairs(animator:GetPlayingAnimationTracks()) do track:AdjustSpeed(0) end
	end

	-- Apply active pose data to the avatar you are currently controlling
	local activeBank = (currentEditTarget == "Human") and humanPoseData or standPoseData
	for _, def in ipairs(activeJointList) do
		local data = activeBank[def.JointName]
		if data then
			local parentPart = char:FindFirstChild(def.ParentPart)
			local joint = parentPart and parentPart:FindFirstChild(def.JointName)
			if joint and joint:IsA("Motor6D") then
				joint.Transform = CFrame.new(data.Pos) * CFrame.fromEulerAnglesXYZ(math.rad(data.Rot.X), math.rad(data.Rot.Y), math.rad(data.Rot.Z))
			end
		end
	end
end) 
