local function buildUnifiedExportString()
	local lines = {}
	table.insert(lines, "local PairedPose = {")
	table.insert(lines, string.format("\tStance = %q,", standStance))
	table.insert(lines, "\tPlayerJoints = {")
	for jointName, data in pairs(humanPoseData) do
		if data.Pos.Magnitude > 0.001 or data.Rot.Magnitude > 0.001 then
			table.insert(lines, string.format("\t\t[%q] = { Pos = Vector3.new(%.2f, %.2f, %.2f), Rot = Vector3.new(%d, %d, %d) },", jointName, data.Pos.X, data.Pos.Y, data.Pos.Z, math.floor(data.Rot.X), math.floor(data.Rot.Y), math.floor(data.Rot.Z)))
		end
	end
	table.insert(lines, "\t},")
	table.insert(lines, "\tStandJoints = {")
	for jointName, data in pairs(standPoseData) do
		if data.Pos.Magnitude > 0.001 or data.Rot.Magnitude > 0.001 then
			table.insert(lines, string.format("\t\t[%q] = { Pos = Vector3.new(%.2f, %.2f, %.2f), Rot = Vector3.new(%d, %d, %d) },", jointName, data.Pos.X, data.Pos.Y, data.Pos.Z, math.floor(data.Rot.X), math.floor(data.Rot.Y), math.floor(data.Rot.Z)))
		end
	end
	table.insert(lines, "\t}")
	table.insert(lines, "}")
	return table.concat(lines, "\n")
end

