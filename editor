local function updateHighlight()
	if not isEditorActive then limbHighlight.Enabled = false; return end
	local char = player.Character
	if not char then limbHighlight.Enabled = false; return end
	local def = activeJointList[selectedLimbIndex]
	if not def then limbHighlight.Enabled = false; return end

	local part = char:FindFirstChild(def.PartName)
	if part then
		limbHighlight.Adornee = part
		limbHighlight.Parent = part
		limbHighlight.Enabled = true
	else
		limbHighlight.Enabled = false
	end
end

local function buildLimbButtons()
	for _, b in ipairs(limbButtons) do b:Destroy() end
	limbButtons = {}

	for idx, def in ipairs(activeJointList) do
		local btn = Instance.new("TextButton")
		btn.Name = def.JointName
		btn.Size = UDim2.new(1, -6, 0, 22)
		btn.BackgroundColor3 = (idx == selectedLimbIndex) and COLOR_ACTIVE or COLOR_BG
		btn.BorderSizePixel = 0
		btn.Font = Enum.Font.GothamBold
		btn.Text = def.Name
		btn.TextSize = 8
		btn.TextColor3 = (idx == selectedLimbIndex) and COLOR_ACCENT or COLOR_MUTED
		btn.Parent = limbScroll

		local bc = Instance.new("UICorner")
		bc.CornerRadius = UDim.new(0, 4)
		bc.Parent = btn

		btn.Activated:Connect(function()
			selectedLimbIndex = idx
			for i, other in ipairs(limbButtons) do
				other.BackgroundColor3 = (i == idx) and COLOR_ACTIVE or COLOR_BG
				other.TextColor3 = (i == idx) and COLOR_ACCENT or COLOR_MUTED
			end
			updateHighlight()
			if refreshScrubberUI then refreshScrubberUI() end
		end)

		table.insert(limbButtons, btn)
	end
	limbScroll.CanvasSize = UDim2.new(0, 0, 0, #activeJointList * 25 + 6)
	updateHighlight()
end

