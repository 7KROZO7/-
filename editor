local function cloneBank(src)
	local copy = {}
	for k, v in pairs(src) do copy[k] = { Pos = v.Pos, Rot = v.Rot } end
	return copy
end

local function pushHistory()
	local activeBank = (currentEditTarget == "Human") and humanPoseData or standPoseData
	table.insert(undoStack, { Target = currentEditTarget, Data = cloneBank(activeBank) })
	if #undoStack > 25 then table.remove(undoStack, 1) end
	redoStack = {}
end

local function initPoseData()
