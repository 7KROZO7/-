-- Continuous Render Loop: Positions the 3D compass and syncs the real-time numeric readout
RunService.RenderStepped:Connect(function()
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root then
		-- Position compass directly at feet, oriented to the character's facing direction
		compassPart.CFrame = CFrame.new(root.Position - Vector3.new(0, 2.8, 0)) * CFrame.Angles(0, math.rad(root.Orientation.Y), 0)
	end
	refreshReadout()
end)

-- Physics Pre-Step: Freezes default animations and applies custom joint transforms
RunService.Stepped:Connect(function()
	local char = player.Character
	if not char then return end

	local hum = char:FindFirstChildOfClass("Humanoid")
	local animator = hum and hum:FindFirstChildOfClass("Animator")

	-- Freeze background walking/idle animations
	if animator then
		for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
			track:AdjustSpeed(0)
		end
	end

	-- Apply custom transforms to each Motor6D
	for _, def in ipairs(activeJointList) do
		local data = poseData[def.JointName]
		if data then
			local parentPart = char:FindFirstChild(def.ParentPart)
			local joint = parentPart and parentPart:FindFirstChild(def.JointName)

			if joint and joint:IsA("Motor6D") then
				local radX = math.rad(data.Rot.X)
				local radY = math.rad(data.Rot.Y)
				local radZ = math.rad(data.Rot.Z)

				joint.Transform = CFrame.new(data.Pos) * CFrame.fromEulerAnglesXYZ(radX, radY, radZ)
			end
		end
	end
end) 
