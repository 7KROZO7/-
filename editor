local function spawnReferenceDummy()
	if referenceDummy then referenceDummy:Destroy() referenceDummy = nil end

	local char = player.Character
	if not char then return end

	char.Archivable = true
	local dummy = char:Clone()
	char.Archivable = false
	dummy.Name = "HumanPoseReferenceDummy"

	for _, p in ipairs(dummy:GetDescendants()) do
		if p:IsA("BasePart") then
			p.CanCollide = false
			p.Anchored = true
			p.Material = Enum.Material.ForceField
			p.Color = Color3.fromRGB(180, 180, 195)
			p.Transparency = 0.35
		elseif p:IsA("Script") or p:IsA("LocalScript") or p:IsA("Sound") then
			p:Destroy()
		end
	end

	-- Apply the exact human pose onto the reference dummy
	for _, def in ipairs(activeJointList) do
		local data = humanPoseData[def.JointName]
		if data then
			local parentPart = dummy:FindFirstChild(def.ParentPart)
			local joint = parentPart and parentPart:FindFirstChild(def.JointName)
			if joint and joint:IsA("Motor6D") then
				joint.Transform = CFrame.new(data.Pos) * CFrame.fromEulerAnglesXYZ(math.rad(data.Rot.X), math.rad(data.Rot.Y), math.rad(data.Rot.Z))
			end
		end
	end

	dummy.Parent = workspace
	referenceDummy = dummy
end

local function removeReferenceDummy()
	if referenceDummy then
		referenceDummy:Destroy()
		referenceDummy = nil
	end
end

