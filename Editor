		expBox.CursorPosition = #exportStr + 1
		copyBtn.Text = "👆 TAP NATIVE 'COPY' ABOVE!"
		task.delay(2, function() copyBtn.Text = "📋 COPY TO CLIPBOARD" end)
	end
end)

