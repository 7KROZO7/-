local limbHighlight = Instance.new("Highlight")
limbHighlight.Name = "LimbEditorHighlight"
limbHighlight.FillColor = COLOR_ACCENT
limbHighlight.FillTransparency = 0.6
limbHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
limbHighlight.OutlineTransparency = 0.2
limbHighlight.Enabled = false

local function updateLimbHighlight()
	local char = player.Character
	if not char then
		limbHighlight.Enabled = false
		return
	end

	local def = activeJointList[selectedLimbIndex]
	if not def then
		limbHighlight.Enabled = false
		return
	end

	-- Locate the body part being posed
	local targetPart = char:FindFirstChild(def.Name) or char:FindFirstChild(def.JointName)
	if not targetPart then
		-- Search by Joint's Part1
		local parentPart = char:FindFirstChild(def.ParentPart)
		if parentPart then
			local joint = parentPart:FindFirstChild(def.JointName)
			if joint and joint:IsA("Motor6D") and joint.Part1 then
				targetPart = joint.Part1
			end
		end
	end

	if targetPart then
		limbHighlight.Adornee = targetPart
		limbHighlight.Parent = targetPart
		limbHighlight.Enabled = true
	else
		limbHighlight.Enabled = false
	end
end

