-- 🪞 MIRROR TOOL
createBottomBtn("🪞 MIRROR", 0.02, 0.3, COLOR_LIGHT_DARK, function()
	local def = activeJointList[selectedLimbIndex]
	if not def then return end

	local sourceName = def.JointName
	local targetName = nil

	-- Pair R15/R6 corresponding limbs
	local pairsMap = {
		["Right Shoulder"] = "Left Shoulder",   ["Left Shoulder"] = "Right Shoulder",
		["Right Hip"]      = "Left Hip",        ["Left Hip"]      = "Right Hip",
		["RightShoulder"]  = "LeftShoulder",    ["LeftShoulder"]  = "RightShoulder",
		["RightElbow"]     = "LeftElbow",       ["LeftElbow"]     = "RightElbow",
		["RightWrist"]     = "LeftWrist",       ["LeftWrist"]     = "RightWrist",
		["RightKnee"]      = "LeftKnee",        ["LeftKnee"]      = "RightKnee",
		["RightAnkle"]     = "LeftAnkle",       ["LeftAnkle"]     = "RightAnkle",
	}

	targetName = pairsMap[sourceName]
	if targetName and poseData[sourceName] and poseData[targetName] then
		local s = poseData[sourceName]
		-- Invert X position and Y/Z rotation for natural anatomical symmetry
		poseData[targetName].Pos = Vector3.new(-s.Pos.X, s.Pos.Y, s.Pos.Z)
		poseData[targetName].Rot = Vector3.new(s.Rot.X, -s.Rot.Y, -s.Rot.Z)
		refreshSliders()
	end
end)

