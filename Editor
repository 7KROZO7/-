-- Auto-detect rig on load
local function detectRig()
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum and hum.RigType == Enum.HumanoidRigType.R6 then
		currentRigType = "R6"
		activeJointList = R6_JOINTS
	else
		currentRigType = "R15"
		activeJointList = R15_JOINTS
	end
	rigToggleBtn.Text = "RIG: " .. currentRigType
	initPoseData()
	buildLimbButtons()
	refreshSliders()
end

detectRig()
player.CharacterAdded:Connect(detectRig)

-- Runs every frame before physics to apply custom joint transforms and freeze animations
RunService.Stepped:Connect(function()
	local char = player.Character
	if not char then return end

	local hum = char:FindFirstChildOfClass("Humanoid")
	local animator = hum and hum:FindFirstChildOfClass("Animator")

	-- Freeze active animation tracks so idle/breathing doesn't fight your pose
	if animator then
		for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
			track:AdjustSpeed(0)
		end
	end

	-- Apply custom transforms to each joint
	for _, def in ipairs(activeJointList) do
		local data = poseData[def.JointName]
		if data then
			local parentPart = char:FindFirstChild(def.ParentPart)
			local joint = parentPart and parentPart:FindFirstChild(def.JointName)

			if joint and joint:IsA("Motor6D") then
				local radX = math.rad(data.Rot.X)
				local radY = math.rad(data.Rot.Y)
				local radZ = math.rad(data.Rot.Z)

				joint.Transform = CFrame.new(data.Pos) * CFrame.fromEulerAnglesXYZ(radX, radY, radZ)
			end
		end
	end
end)
