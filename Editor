local function createSlider(title, minVal, maxVal, isDegree, getter, setter)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, -6, 0, 26)
	row.BackgroundTransparency = 1
	row.Parent = slidersContainer

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(0.48, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextSize = 8
	label.TextColor3 = COLOR_TEXT
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = row

	local zeroBtn = Instance.new("TextButton")
	zeroBtn.Size = UDim2.fromOffset(16, 16)
	zeroBtn.Position = UDim2.new(0.48, 2, 0.5, -8)
	zeroBtn.BackgroundColor3 = COLOR_LIGHT_DARK
	zeroBtn.BorderSizePixel = 0
	zeroBtn.Font = Enum.Font.GothamBold
	zeroBtn.Text = "0"
	zeroBtn.TextSize = 8
	zeroBtn.TextColor3 = COLOR_MUTED
	zeroBtn.Parent = row
	local zc = Instance.new("UICorner")
	zc.CornerRadius = UDim.new(0, 3)
	zc.Parent = zeroBtn

	local track = Instance.new("Frame")
	track.Size = UDim2.new(0.42, 0, 0, 12)
	track.Position = UDim2.new(1, -95, 0.5, -6)
	track.BackgroundColor3 = COLOR_BG
	track.BorderSizePixel = 0
	track.Active = true
	track.Parent = row
	local tc = Instance.new("UICorner")
	tc.CornerRadius = UDim.new(0, 4)
	tc.Parent = track

	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(0.5, 0, 1, 0)
	fill.BackgroundColor3 = isDegree and COLOR_ACCENT or Color3.fromRGB(80, 170, 255)
	fill.BorderSizePixel = 0
	fill.Parent = track
	local fc = Instance.new("UICorner")
	fc.CornerRadius = UDim.new(0, 4)
	fc.Parent = fill

	local function updateDisplay(val)
		local ratio = math.clamp((val - minVal) / (maxVal - minVal), 0, 1)
		fill.Size = UDim2.new(ratio, 0, 1, 0)
		if isDegree then
			label.Text = string.format("%s: %d°", title, math.floor(val))
		else
			label.Text = string.format("%s: %.2f", title, val)
		end
	end

	local function setValFromX(xPos)
		local ratio = math.clamp((xPos - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		local val = minVal + (maxVal - minVal) * ratio
		setter(val)
		updateDisplay(val)
	end

	local sliding = false
	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			sliding = true
			setValFromX(input.Position.X)
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					sliding = false
				end
			end)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if sliding and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
			setValFromX(input.Position.X)
		end
	end)

	zeroBtn.Activated:Connect(function()
		setter(0)
		updateDisplay(0)
	end)

	return {
		Refresh = function()
			updateDisplay(getter())
		end
	}
end

local function getActivePoseEntry()
	local def = activeJointList[selectedLimbIndex]
	if not def then return nil end
	if not poseData[def.JointName] then
		poseData[def.JointName] = { Pos = Vector3.zero, Rot = Vector3.zero }
	end
	return poseData[def.JointName]
end

